# OpenAI互換 Chat Completions エンドポイント (/chat/completions を除いたベースURL)
# 例1) OpenAI本家:            https://api.openai.com/v1
# 例2) Azure OpenAI互換proxy: https://your-resource.openai.azure.com/openai/deployments/xxx
# 例3) ローカルLLM(vLLM等):   http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 構造化抽出に使うモデル名。長文の日本語抽出＋JSON出力の安定性を重視するなら
# gpt-4o / gpt-4o-mini 等、指示追従性の高いモデルを推奨。
OPENAI_MODEL=gpt-4o-mini
